name = "00todo-api"
main = "src/index.ts"
compatibility_date = "2026-09-27"
workers_dev = false
preview_urls = false

[vars]
# Start dates/times are compared in this time zone when an API caller omits
# ?today=YYYY-MM-DD&time=HH:mm. iOS uses the device's local clock.
DEFAULT_TIME_ZONE = "UTC"
# Service name on the MCP consent page and in MCP server metadata. Unset
# means the generic "Todo"; a fork should use its own name, not 00Todo.
# APP_NAME = "My Todo"
PUBLIC_ORIGIN = "https://api.example.com"
# Native App ID (bundle ID) and web Services ID must be associated with the
# same Sign in with Apple primary app in your Apple Developer account.
APPLE_APP_CLIENT_ID = "com.example.zerozerotodo"
APPLE_WEB_CLIENT_ID = "com.example.zerozerotodo.web"
APPLE_WEB_REDIRECT_URI = "https://api.example.com/auth/apple/callback"
APPLE_TEAM_ID = "REPLACE_WITH_APPLE_TEAM_ID"
APPLE_KEY_ID = "REPLACE_WITH_SIGN_IN_WITH_APPLE_KEY_ID"
# APPLE_PRIVATE_KEY and OAUTH_SIGNING_SECRET are Wrangler secrets, not vars.
# Optional verified MCP client registry. Keys are exact HTTPS OAuth callback
# URLs; values are canonical names owned by this deployment. A match adds a
# "Verified client" badge and replaces the self-asserted client_name on the
# consent screen and in the connection label. Unknown clients still work but
# show as unverified. Never use URL prefixes or localhost callbacks here.
# MCP_VERIFIED_CLIENTS = "{\"https://chatgpt.com/connector_platform_oauth_redirect\":\"ChatGPT\",\"https://claude.ai/api/mcp/auth_callback\":\"Claude\",\"https://claude.com/api/mcp/auth_callback\":\"Claude\",\"https://www.cursor.com/agents/mcp/oauth/callback\":\"Cursor\",\"https://vscode.dev/redirect\":\"VS Code\",\"https://insiders.vscode.dev/redirect\":\"VS Code Insiders\",\"https://callback.mistral.ai/v1/integrations_auth/oauth2_callback\":\"Mistral\",\"https://manus.im/api/webhook/mcp/callback\":\"Manus\"}"

# Replace with the hostname you own before deployment. The planned production
# host is 00todo.com; api.example.com keeps this public sample deploy-safe.
[[routes]]
pattern = "api.example.com"
custom_domain = true

[[d1_databases]]
binding = "DB"
database_name = "00todo"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"

# Edge rate limits: counted by Cloudflare, so refused requests never reach D1
# and limits cost no database writes. Periods must be 10 or 60 seconds, and
# namespace ids must be unique within your Cloudflare account.
[[ratelimits]]
name = "SOURCE_LIMITER"   # every request, per client IP
namespace_id = "20001"
  [ratelimits.simple]
  limit = 600
  period = 60

[[ratelimits]]
name = "SIGN_IN_LIMITER"  # sign-in and OAuth routes, per client IP
namespace_id = "20002"
  [ratelimits.simple]
  limit = 20
  period = 60

[[ratelimits]]
name = "TENANT_LIMITER"   # authenticated REST and MCP requests, per account
namespace_id = "20003"
  [ratelimits.simple]
  limit = 300
  period = 60

# Expired OAuth flows, codes, and credentials are swept occasionally by the
# sign-in routes. On Workers Paid (or with a spare cron on Free, which allows
# five per account), uncomment this to sweep on a schedule instead.
# [triggers]
# crons = ["17 4 * * *"]

[observability]
enabled = true
