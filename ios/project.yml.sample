name: ZeroZeroTodo
options:
  bundleIdPrefix: com.example
  deploymentTarget:
    iOS: "27.0"
  createIntermediateGroups: true
settings:
  base:
    SWIFT_VERSION: 5.10
    MARKETING_VERSION: "1.0"
    CURRENT_PROJECT_VERSION: "1"
    DEVELOPMENT_TEAM: ""
    CODE_SIGN_STYLE: Automatic
targets:
  ZeroZeroTodo:
    type: application
    platform: iOS
    sources:
      - path: Sources
        excludes:
          - Widgets/**
          - ShareExtension/**
      - path: Resources/App/Assets.xcassets
    info:
      path: Resources/App/Info.plist
      properties:
        CFBundleDisplayName: 00Todo
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        UILaunchScreen: {}
        ITSAppUsesNonExemptEncryption: false
        TodoServerBaseURL: https://api.example.com
        TodoAppGroup: group.com.example.zerozerotodo
        NSMicrophoneUsageDescription: "00Todo uses the microphone to dictate a task or shopping list on your device."
        NSSpeechRecognitionUsageDescription: "00Todo transcribes your spoken task or shopping list on your device."
        CFBundleURLTypes:
          - CFBundleTypeRole: Editor
            CFBundleURLName: zerozerotodo.quick-add
            CFBundleURLSchemes:
              - zerozerotodo
        UIApplicationShortcutItems:
          - UIApplicationShortcutItemType: com.00todo.quick-add.voice
            UIApplicationShortcutItemTitle: Speak to 00Todo
            UIApplicationShortcutItemIconType: UIApplicationShortcutIconTypeAudio
          - UIApplicationShortcutItemType: com.00todo.quick-add.text
            UIApplicationShortcutItemTitle: Quick Add
            UIApplicationShortcutItemIconType: UIApplicationShortcutIconTypeCompose
        NSAppTransportSecurity:
          NSAllowsLocalNetworking: true
        UISupportedInterfaceOrientations:
          - UIInterfaceOrientationPortrait
          - UIInterfaceOrientationPortraitUpsideDown
          - UIInterfaceOrientationLandscapeLeft
          - UIInterfaceOrientationLandscapeRight
    entitlements:
      path: Resources/App/ZeroZeroTodo.entitlements
      properties:
        com.apple.developer.applesignin:
          - Default
        com.apple.security.application-groups:
          - group.com.example.zerozerotodo
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerotodo
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
        TARGETED_DEVICE_FAMILY: "1,2"
    dependencies:
      - target: ZeroZeroTodoWidgets
        embed: true
      - target: ZeroZeroTodoShare
        embed: true

  ZeroZeroTodoWidgets:
    type: app-extension
    platform: iOS
    sources:
      - path: Sources/Widgets
      - path: Sources/WidgetSnapshot.swift
    info:
      path: Resources/Widgets/Info.plist
      properties:
        CFBundleDisplayName: 00Todo
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        TodoAppGroup: group.com.example.zerozerotodo
        NSExtension:
          NSExtensionPointIdentifier: com.apple.widgetkit-extension
    entitlements:
      path: Resources/Widgets/ZeroZeroTodoWidgets.entitlements
      properties:
        com.apple.security.application-groups:
          - group.com.example.zerozerotodo
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerotodo.widgets
        APPLICATION_EXTENSION_API_ONLY: YES
        INFOPLIST_KEY_UIApplicationSupportsMultipleScenes: YES

  ZeroZeroTodoShare:
    type: app-extension
    platform: iOS
    sources:
      - path: Sources/ShareExtension
      - path: Sources/ShareTaskContent.swift
      - path: Sources/SharedSession.swift
      - path: Sources/SharedTaskInbox.swift
    info:
      path: Resources/Share/Info.plist
      properties:
        CFBundleDisplayName: 00Todo
        CFBundleShortVersionString: $(MARKETING_VERSION)
        CFBundleVersion: $(CURRENT_PROJECT_VERSION)
        TodoAppGroup: group.com.example.zerozerotodo
        TodoServerBaseURL: https://api.example.com
        NSExtension:
          NSExtensionPointIdentifier: com.apple.share-services
          NSExtensionPrincipalClass: $(PRODUCT_MODULE_NAME).ShareViewController
          NSExtensionAttributes:
            NSExtensionActivationRule:
              NSExtensionActivationSupportsText: true
              NSExtensionActivationSupportsWebURLWithMaxCount: 1
              NSExtensionActivationSupportsWebPageWithMaxCount: 1
    entitlements:
      path: Resources/Share/ZeroZeroTodoShare.entitlements
      properties:
        com.apple.security.application-groups:
          - group.com.example.zerozerotodo
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerotodo.share
        APPLICATION_EXTENSION_API_ONLY: YES
        TARGETED_DEVICE_FAMILY: "1,2"

  ZeroZeroTodoScreenshots:
    type: bundle.ui-testing
    platform: iOS
    sources:
      - path: ScreenshotUITests
    dependencies:
      - target: ZeroZeroTodo
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.zerozerotodo.screenshots
        TEST_TARGET_NAME: ZeroZeroTodo
        GENERATE_INFOPLIST_FILE: YES

schemes:
  ZeroZeroTodo:
    build:
      targets:
        ZeroZeroTodo: all
    run:
      config: Debug
    archive:
      config: Release
  ZeroZeroTodoScreenshots:
    build:
      targets:
        ZeroZeroTodo: all
        ZeroZeroTodoScreenshots: [test]
    test:
      config: Debug
      targets:
        - ZeroZeroTodoScreenshots
